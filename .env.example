# Copy to `.env.local` for local development (never commit secrets).
# On Vercel: set the same keys in Project → Settings → Environment Variables
# (or install the Inngest Vercel integration for the two INNGEST_* keys).

# --- Local Inngest (required for `npm run dev`) ---
# Forces SDK into Dev Server mode. Do NOT set this on Vercel.
INNGEST_DEV=1

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: public origin of the app (https://your-domain.com), used in password-reset /
# confirmation emails. Falls back to VERCEL_PROJECT_PRODUCTION_URL, then the request host.
NEXT_PUBLIC_SITE_URL=

# --- AI / media ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI33_API_KEY=
PEXELS_API_KEY=

# --- Free stock media providers (optional) ---
# Used by BOTH the classic "Ingyenes stock tartalom" channel setting and Pro
# mode. A provider without a key is simply skipped in the fallback chain —
# never an error. Wikimedia Commons, Openverse and Internet Archive need no
# key at all and are the best sources for period-accurate material.
#   Pexels   -> PEXELS_API_KEY above (video + image)
#   Pixabay  -> free key at pixabay.com/api/docs (video + image)
PIXABAY_API_KEY=
# Wan video uses OPENROUTER_API_KEY (same as Qwen) via POST /api/v1/videos

# --- Cloudflare R2 (scene images + Wan .mp4) ---
# Bucket Settings: enable Public Development URL + CORS (GET/HEAD, origin *)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=lumen-studio-videos
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
#
# One-shot migrate Supabase video_images → R2, then empty the bucket:
#   npx tsx --env-file=.env.local scripts/migrate-images-to-r2.ts


# --- Vercel / production Inngest (set in Vercel dashboard, not in .env.local) ---
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Optional custom domain for Inngest sync:
# INNGEST_SERVE_ORIGIN=https://your-domain.com
